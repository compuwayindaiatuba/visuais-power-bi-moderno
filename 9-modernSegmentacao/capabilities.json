  "dataViewMappings": [
    {
      "conditions": [
        {
          "category": {
            "min": 1,
            "max": 1
          },
          "measure": {
            "max": 1
          },
          "date": {
            "max": 1
          },
          "icon": {
            "max": 1
          },
          "menu": {
            "max": 1
          }
        },
        {
          "category": {
            "max": 1
          },
          "measure": {
            "max": 1
          },
          "date": {
            "min": 1,
            "max": 1
          },
          "icon": {
            "max": 1
          },
          "menu": {
            "max": 1
          }
        }
      ],
      "categorical": {
        "categories": {
          "select": [
            {
              "for": {
                "in": "category"
              }
            },
            {
              "for": {
                "in": "date"
              }
            },
            {
              "for": {
                "in": "icon"
              }
            }
          ],
          "dataReductionAlgorithm": {
            "top": {
              "count": 1000
            }
          }
        },
        "values": {
          "select": [
            {
              "bind": {
                "to": "measure"
              }
            },
            {
              "bind": {
                "to": "menu"
              }
            }
          ]
        }
      }
    }
