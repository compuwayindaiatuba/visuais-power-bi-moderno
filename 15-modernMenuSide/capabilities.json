  "dataViewMappings": [
    {
      "conditions": [
        {
          "order": {
            "max": 1
          },
          "category": {
            "max": 1
          },
          "label": {
            "min": 1,
            "max": 1
          },
          "icon": {
            "max": 1
          },
          "targetUrl": {
            "max": 1
          },
          "theme": {
            "max": 1
          },
          "menu": {
            "max": 1
          }
        }
      ],
      "table": {
        "rows": {
          "select": [
            {
              "for": {
                "in": "order"
              }
            },
            {
              "for": {
                "in": "category"
              }
            },
            {
              "for": {
                "in": "label"
              }
            },
            {
              "for": {
                "in": "icon"
              }
            },
            {
              "for": {
                "in": "targetUrl"
              }
            },
            {
              "for": {
                "in": "theme"
              }
            },
            {
              "for": {
                "in": "menu"
              }
            }
          ],
          "dataReductionAlgorithm": {
            "top": {
              "count": 5000
            }
          }
        }
      }
    }
