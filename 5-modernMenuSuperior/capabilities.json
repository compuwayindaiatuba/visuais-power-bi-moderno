  "dataViewMappings": [
    {
      "conditions": [
        {
          "menu": {
            "min": 1,
            "max": 1
          },
          "title": {
            "max": 1
          },
          "subtitle": {
            "max": 1
          },
          "icon": {
            "max": 1
          },
          "menuVisibility": {
            "max": 1
          }
        }
      ],
      "categorical": {
        "categories": {
          "select": [
            {
              "for": {
                "in": "menu"
              }
            },
            {
              "for": {
                "in": "title"
              }
            },
            {
              "for": {
                "in": "subtitle"
              }
            },
            {
              "for": {
                "in": "icon"
              }
            }
          ],
          "dataReductionAlgorithm": {
            "top": {
              "count": 500
            }
          }
        },
        "values": {
          "select": [
            {
              "bind": {
                "to": "menuVisibility"
              }
            }
          ]
        }
      }
    }
  ],
  "supportsKeyboardFocus": true,
  "supportsLandingPage": true,
  "supportsEmptyDataView": true,
  "supportsMultiVisualSelection": true,
  "supportsSynchronizingFilterState": true,
  "privileges": [
    {
