  "dataViewMappings": [
    {
      "conditions": [
        {
          "rows": {
            "min": 1,
            "max": 10
          },
          "columns": {
            "max": 10
          },
          "values": {
            "max": 30
          },
          "menu": {
            "max": 1
          }
        }
      ],
      "matrix": {
        "rows": {
          "for": {
            "in": "rows"
          },
          "dataReductionAlgorithm": {
            "top": {
              "count": 3000
            }
          }
        },
        "columns": {
          "for": {
            "in": "columns"
          },
          "dataReductionAlgorithm": {
            "top": {
              "count": 300
            }
          }
        },
        "values": {
          "select": [
            {
              "for": {
                "in": "values"
              }
            },
            {
              "for": {
                "in": "menu"
              }
            }
          ]
        }
      }
    }
  ],
  "tooltips": {
    "supportedTypes": {
      "default": true,
      "canvas": true
    },
    "roles": [
      "rows",
      "columns",
      "values"
    ],
    "supportEnhancedTooltips": true
  },
  "drilldown": {
    "roles": [
      "rows"
    ]
  },
  "expandCollapse": {
    "roles": [
      "rows"
    ],
    "addDataViewFlags": {
      "defaultValue": true
    }
  },
  "privileges": []
}
